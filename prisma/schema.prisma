generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 홈페이지 1:1 문의 (문의 폼 제출 건)
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  company   String?
  phone     String
  message   String
  /// NEW | IN_PROGRESS | DONE
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

/// 뉴스룸 공지사항 (관리자 CRUD)
model NewsPost {
  id        String   @id @default(cuid())
  category  String
  date      String
  title     String
  desc      String
  highlight Boolean  @default(false)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 사이트 설정 (키-값 저장소: 회사 정보 등)
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
